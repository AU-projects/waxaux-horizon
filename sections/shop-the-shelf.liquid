{% comment %}
  Category card grid — editorial routing block for the homepage.
  Each block is one card: square photo tile with a small mint accent dash,
  title, short description, and a "Shop →" text link.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="shop-the-shelf section spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if section.settings.section_width == 'page-width' %} page-width{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="shop-the-shelf__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-the-shelf__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <span class="shop-the-shelf__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="shop-the-shelf__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <div class="shop-the-shelf__card" {{ block.shopify_attributes }}>
          <div class="shop-the-shelf__tile">
            <span class="shop-the-shelf__dash" aria-hidden="true"></span>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 90vw', widths: '300,450,600', class: 'shop-the-shelf__tile-img' }}
            {%- else -%}
              <span class="shop-the-shelf__tile-placeholder">Square photo 1:1</span>
            {%- endif -%}
          </div>
          <div class="shop-the-shelf__body">
            <div class="shop-the-shelf__name">{{ block.settings.title }}</div>
            {%- if block.settings.description != blank -%}
              <p class="shop-the-shelf__desc">{{ block.settings.description }}</p>
            {%- endif -%}
            <a href="{{ block.settings.url | default: '#' }}" class="shop-the-shelf__cta">
              <span class="shop-the-shelf__cta-label">{{ block.settings.cta_label | default: 'Shop' }}</span>
              <span class="shop-the-shelf__cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .shop-the-shelf {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .shop-the-shelf__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--color-foreground, #111);
    margin-bottom: 0;
  }

  .shop-the-shelf__heading {
    font: 700 15px/1 var(--font-heading--family, sans-serif);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .shop-the-shelf__eyebrow {
    font: 500 11px var(--font-accent--family, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .shop-the-shelf__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding: 24px 0 30px;
    border-bottom: 2px solid var(--color-foreground, #111);
  }

  .shop-the-shelf__card {
    display: flex;
    flex-direction: column;
    background: var(--color-background, #fff);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.1);
  }

  /* Third card is mint (Turntables & Hardware in the default block order). */
  .shop-the-shelf__card:nth-child(3) {
    background: var(--waxaux-mint, #6fdda0);
  }

  .shop-the-shelf__card:nth-child(3) .shop-the-shelf__tile {
    background: transparent;
  }

  .shop-the-shelf__card:nth-child(3) .shop-the-shelf__desc {
    color: #1e3d2c;
  }

  /* Square tile via padding-bottom hack — reliable across flex and grid contexts. */
  .shop-the-shelf__tile {
    position: relative;
    padding-bottom: 100%;
    background: repeating-linear-gradient(135deg, #e8e6e1 0 7px, #f3f2ee 7px 14px);
    overflow: hidden;
  }

  .shop-the-shelf__tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-the-shelf__tile-placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font: 500 9.5px var(--font-accent--family, monospace);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #8a8a85;
    background: rgba(255,255,255,0.8);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .shop-the-shelf__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }

  .shop-the-shelf__name {
    font: 700 18px/1.15 var(--font-heading--family, sans-serif);
    letter-spacing: 0.012em;
    text-transform: uppercase;
  }

  .shop-the-shelf__desc {
    font: 400 12px/1.55 var(--font-body--family, sans-serif);
    color: #6f6e69;
    flex: 1;
    margin: 0;
  }

  /* Arrow → CTA: original text-link style. */
  .shop-the-shelf__cta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font: 700 10.5px var(--font-heading--family, sans-serif);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground, #111);
  }

  .shop-the-shelf__cta-label {
    border-bottom: 3px solid var(--waxaux-mint, #6fdda0);
    padding-bottom: 2px;
  }

  .shop-the-shelf__cta-arrow {
    color: var(--waxaux-mint, #6fdda0);
  }

  .shop-the-shelf__dash {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .shop-the-shelf__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .shop-the-shelf__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the shelf",
  "tag": "section",
  "class": "section-shop-the-shelf",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the shelf"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (right-aligned)",
      "default": "Four ways in"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category name"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category photo (square)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the shelf",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Sleeves & Storage",
            "description": "Inner, outer, crates and dividers — 7″, 10″ and 12″"
          }
        },
        {
          "type": "category",
          "settings": { "title": "Cleaning", "description": "Fluids, brushes and full kits from Brillo and Tinyl" }
        },
        {
          "type": "category",
          "settings": { "title": "Turntables & Hardware", "description": "Clamps, weights, belts and styli" }
        },
        {
          "type": "category",
          "settings": { "title": "Slipmats", "description": "Felt, cork and acrylic, 3mm and up" }
        }
      ]
    }
  ]
}
{% endschema %}
