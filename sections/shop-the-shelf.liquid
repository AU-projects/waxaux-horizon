{% comment %}
  Category carousel — t5 design: horizontal scroll, 330px tiles,
  label overlay pill at tile bottom, third tile mint.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="shop-the-shelf section spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="shop-the-shelf__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-the-shelf__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <span class="shop-the-shelf__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="shop-the-shelf__track">
    {%- assign card_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- assign card_index = card_index | plus: 1 -%}
        <div class="shop-the-shelf__card{% if card_index == 3 %} shop-the-shelf__card--mint{% endif %}" {{ block.shopify_attributes }}>
          <div class="shop-the-shelf__tile">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '340px', widths: '340,680', class: 'shop-the-shelf__tile-img' }}
            {%- endif -%}
          </div>
          <div class="shop-the-shelf__body">
            <span class="shop-the-shelf__name">{{ block.settings.title }}</span>
            <a href="{{ block.settings.url | default: '#' }}" class="shop-the-shelf__cta" aria-label="{{ block.settings.title }}">→</a>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="shop-the-shelf__dots" aria-hidden="true">
    <span class="shop-the-shelf__dot shop-the-shelf__dot--active"></span>
    <span class="shop-the-shelf__dot"></span>
    <span class="shop-the-shelf__dot"></span>
  </div>
</div>

{% stylesheet %}
  /* t5 design — horizontal drag carousel, overlay label pill */

  .shop-the-shelf {
    display: flex;
    flex-direction: column;
  }

  /* Heading row */
  .shop-the-shelf__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 0 20px;
  }

  .shop-the-shelf__heading {
    font: 700 36px/1 var(--font-heading--family, sans-serif);
    letter-spacing: 0.006em;
    text-transform: uppercase;
    margin: 0;
    color: #111;
  }

  .shop-the-shelf__eyebrow {
    font: 400 12.5px var(--font-body--family, sans-serif);
    color: #8a8a85;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Horizontal scroll track — left edge flush with section, 4th card peeks */
  .shop-the-shelf__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Pull left margin so first card aligns to the section edge */
    margin-inline: calc(-1 * var(--page-width-padding, 20px));
    padding-inline: var(--page-width-padding, 20px);
    padding-bottom: 4px;
  }

  .shop-the-shelf__track::-webkit-scrollbar {
    display: none;
  }

  /* Each card: 330px fixed, square tile, rounded 18px */
  .shop-the-shelf__card {
    flex: 0 0 330px;
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    scroll-snap-align: start;
    background: #f4f3ef;
  }

  /* Third card: mint tile */
  .shop-the-shelf__card--mint {
    background: var(--waxaux-mint, #6fdda0);
  }

  /* Square tile via padding-bottom trick */
  .shop-the-shelf__tile {
    position: relative;
    padding-bottom: 100%;
    background: repeating-linear-gradient(135deg, #eae8e3 0 7px, #f4f3ef 7px 14px);
    overflow: hidden;
  }

  .shop-the-shelf__card--mint .shop-the-shelf__tile {
    background: transparent;
  }

  .shop-the-shelf__tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Label overlay pill — white bar at tile bottom with title + round arrow */
  .shop-the-shelf__body {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    background: #fff;
    border-radius: 999px;
    padding: 11px 10px 11px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    z-index: 2;
  }

  .shop-the-shelf__name {
    font: 600 14px/1.2 var(--font-heading--family, sans-serif);
    color: #111;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Round arrow button — mint on first card, grey on others */
  .shop-the-shelf__cta {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #f4f3ef;
    display: grid;
    place-items: center;
    text-decoration: none;
    color: #111;
    font: 600 13px/1 var(--font-heading--family, sans-serif);
    transition: background 0.15s;
  }

  .shop-the-shelf__card:first-child .shop-the-shelf__cta {
    background: var(--waxaux-mint, #6fdda0);
  }

  /* Dot pagination */
  .shop-the-shelf__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 20px 0 4px;
  }

  .shop-the-shelf__dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #dcdad4;
  }

  .shop-the-shelf__dot--active {
    width: 24px;
    background: #111;
  }

  @media screen and (max-width: 749px) {
    .shop-the-shelf__card {
      flex: 0 0 80vw;
    }

    .shop-the-shelf__heading {
      font-size: 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the shelf",
  "tag": "section",
  "class": "section-shop-the-shelf",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the shelf"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (right-aligned)",
      "default": "Four ways in"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category name"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category photo (square)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the shelf",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Sleeves & Storage",
            "description": "Inner, outer, crates and dividers — 7″, 10″ and 12″"
          }
        },
        {
          "type": "category",
          "settings": { "title": "Cleaning", "description": "Fluids, brushes and full kits from Brillo and Tinyl" }
        },
        {
          "type": "category",
          "settings": { "title": "Turntables & Hardware", "description": "Clamps, weights, belts and styli" }
        },
        {
          "type": "category",
          "settings": { "title": "Slipmats", "description": "Felt, cork and acrylic, 3mm and up" }
        }
      ]
    }
  ]
}
{% endschema %}
